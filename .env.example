# Every setting the server knows, with its default. The server reads these from the
# environment of the shell that starts it, not from a .env file, so set one for a run
# on the command line (README, "Run"). Only the Vite dev server reads a .env file,
# and only for PORT. Never commit a .env file or a real key.
PORT=8000
ALLOWED_ORIGINS=
LOG_LEVEL=INFO
DEFAULT_ROUNDS=7
POSITION_LIMIT=5
# Sign in with Google: the OAuth client ID from Google Cloud. Empty hides the button.
GOOGLE_CLIENT_ID=
# SQLite file for accounts and saved games. Fly mounts a volume at /data.
DATABASE_PATH=data/almanac.db
# Local playtests only. Never set either on a deployed server.
ALLOW_UNVERIFIED_QUESTIONS=0
ALLOW_DEV_LOGIN=0
# Web push (M5). Both empty turns it off. Make a pair with `python -m server.push --keys`
# and set them as Fly secrets; the private key never goes in the repo.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# The contact push services see. Empty uses the first https ALLOWED_ORIGINS entry.
VAPID_SUBJECT=
# Live mode (M6): the nightly 9 PM Eastern game. 0 turns it off.
LIVE_MODE=1
# Local testing only: open a live lobby at startup that starts this many seconds later.
LIVE_DEV_START_SECONDS=
