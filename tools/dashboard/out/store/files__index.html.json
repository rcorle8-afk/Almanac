{"text": "<meta name=\"dash-one-writer\">\n<style>\n/* Layout: a summary band (sentence + five tiles), then a tab menu over five sections; Progress pairs a section menu with the goal list. */\n.al { display: grid; gap: var(--cds-gap-lg); font-family: var(--font-anthropic-sans); color: var(--color-fg); }\n.al h1 { margin: 0; font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); text-wrap: balance; }\n.al h2 { margin: 0; font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); text-wrap: balance; }\n.al h3 { margin: 0; font-size: var(--cds-font-size-body); font-weight: var(--cds-font-weight-medium); }\n.al p { margin: 0; }\n.al-head { display: grid; gap: var(--cds-gap-sm); }\n.al-lede { max-width: 72ch; color: var(--color-fg-muted); line-height: 1.5; }\n.al-lede b { color: var(--color-fg); font-weight: var(--cds-font-weight-medium); font-variant-numeric: tabular-nums; }\n.al-fresh { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n.al-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: var(--cds-gap-md); }\n.al-card { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); min-width: 0; }\n.al-tile { display: grid; gap: var(--cds-gap-xs); align-content: start; }\n.al-label { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); letter-spacing: .02em; }\n.al-big { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: 2rem; line-height: 1.1; font-variant-numeric: tabular-nums; }\n.al-big small { font-family: var(--font-anthropic-sans); font-size: var(--cds-font-size-body); color: var(--color-fg-muted); }\n.al-sub { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); line-height: 1.4; }\n.al-meter { height: 6px; background: var(--color-border-line); border-radius: 3px; overflow: hidden; }\n.al-meter > span { display: block; height: 100%; width: 0; background: var(--color-ok); border-radius: 3px; }\n.al-tabs { display: flex; flex-wrap: wrap; gap: var(--cds-gap-xs); border-bottom: 1px solid var(--color-border-line); }\n.al-tab { appearance: none; background: none; border: 0; border-bottom: 2px solid transparent; margin-bottom: -1px; padding: var(--cds-pad-sm) var(--cds-pad-md); font: inherit; color: var(--color-fg-muted); cursor: pointer; }\n.al-tab:hover { color: var(--color-fg); }\n.al-tab[aria-selected=\"true\"] { color: var(--color-fg); border-bottom-color: var(--color-fg); font-weight: var(--cds-font-weight-medium); }\n.al-tab:focus-visible, .al-menu button:focus-visible { outline: 2px solid var(--color-fg); outline-offset: 2px; }\n.al-section { display: grid; gap: var(--cds-gap-lg); }\n.al-block { display: grid; gap: var(--cds-gap-md); }\n.al-blockhead { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--cds-gap-sm); }\n.al-note { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); max-width: 72ch; line-height: 1.45; }\n/* Status pills: done reads as good, in progress as under way, the rest progressively quieter. */\n.al-pill { display: inline-block; white-space: nowrap; font-size: var(--cds-font-size-caption); line-height: 1.6; padding: 0 8px; border-radius: 999px; border: 1px solid var(--color-border-line); color: var(--color-fg-muted); }\n.st-done { color: var(--color-ok); border-color: color-mix(in srgb, var(--color-ok) 45%, transparent); background: color-mix(in srgb, var(--color-ok) 12%, transparent); }\n.st-in_progress { color: var(--color-warn); border-color: color-mix(in srgb, var(--color-warn) 45%, transparent); background: color-mix(in srgb, var(--color-warn) 12%, transparent); }\n.st-ongoing { color: var(--color-fg); }\n.st-planned { border-style: dashed; }\n.st-not_started { opacity: .85; }\n.st-untracked { color: var(--color-bad); border-color: color-mix(in srgb, var(--color-bad) 45%, transparent); }\n/* Milestones */\n.al-steps { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: var(--cds-gap-sm); }\n.al-step { display: grid; gap: var(--cds-gap-xs); align-content: start; padding: var(--cds-pad-md); border-radius: var(--cds-radius); border: 1px solid var(--color-border-line); background: var(--color-panel); min-width: 0; }\n.al-step-top { display: flex; justify-content: space-between; align-items: baseline; gap: var(--cds-gap-xs); }\n.al-step-id { font-family: var(--font-anthropic-serif); font-size: 1.25rem; font-variant-numeric: tabular-nums; }\n.al-step-name { font-weight: var(--cds-font-weight-medium); }\n/* Goals: the progress menu beside the list */\n.al-principles { display: flex; flex-wrap: wrap; gap: var(--cds-gap-sm); }\n.al-principle { font-family: var(--font-anthropic-serif); font-size: var(--cds-font-size-heading); padding: var(--cds-pad-sm) var(--cds-pad-md); border-left: 2px solid var(--color-border-line); }\n.al-goals { display: flex; flex-wrap: wrap; gap: var(--cds-gap-lg); align-items: start; }\n.al-menu { flex: 1 1 210px; max-width: 100%; display: grid; gap: var(--cds-gap-xs); }\n.al-menu button { appearance: none; text-align: left; font: inherit; color: var(--color-fg); background: transparent; border: 1px solid transparent; border-radius: var(--cds-radius); padding: var(--cds-pad-sm) var(--cds-pad-md); cursor: pointer; display: grid; gap: 4px; }\n.al-menu button:hover { background: var(--color-panel); }\n.al-menu button[aria-pressed=\"true\"] { background: var(--color-panel); border-color: var(--color-border-line); }\n.al-menu-row { display: flex; justify-content: space-between; gap: var(--cds-gap-sm); }\n.al-menu-count { font-variant-numeric: tabular-nums; color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); white-space: nowrap; }\n.al-list-wrap { flex: 3 1 320px; min-width: 0; display: grid; gap: var(--cds-gap-sm); }\n.al-filter { display: flex; flex-wrap: wrap; align-items: center; gap: var(--cds-gap-sm); }\n.al-list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--cds-gap-xs); }\n.al-goal { display: grid; grid-template-columns: 1fr auto; gap: 2px var(--cds-gap-sm); padding: var(--cds-pad-sm) var(--cds-pad-md); border-bottom: 1px solid var(--color-border-line); }\n.al-goal.depth-2 { margin-left: var(--cds-pad-lg); border-left: 2px solid var(--color-border-line); }\n.al-goal-text { font-weight: var(--cds-font-weight-medium); min-width: 0; }\n.al-goal-note { grid-column: 1 / -1; font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); line-height: 1.45; }\n.al-goal-meta { grid-column: 1 / -1; font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n.al-section-tag { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n/* Timeline */\n.al-timeline { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--cds-gap-sm); }\n.al-timeline li { display: grid; grid-template-columns: 7.5rem 1fr; gap: var(--cds-gap-md); }\n.al-date { font-variant-numeric: tabular-nums; color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); padding-top: 2px; }\n/* Tables */\n.al-scroll { overflow-x: auto; }\n.al-table { width: 100%; border-collapse: collapse; font-size: var(--cds-font-size-body); }\n.al-table th { text-align: left; font-weight: var(--cds-font-weight-medium); font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); padding: var(--cds-pad-sm); border-bottom: 1px solid var(--color-border-line); white-space: nowrap; }\n.al-table td { padding: var(--cds-pad-sm); border-bottom: 1px solid var(--color-border-line); vertical-align: top; }\n.al-table .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }\n.al-table td.wrap { min-width: 16rem; color: var(--color-fg-muted); }\n.al-table tfoot td { font-weight: var(--cds-font-weight-medium); border-bottom: 0; }\n.al-empty { color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); padding: var(--cds-pad-sm) 0; }\n/* Services */\n.al-services { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: var(--cds-gap-md); }\n.al-service { display: grid; gap: var(--cds-gap-sm); align-content: start; }\n.al-service-top { display: flex; justify-content: space-between; align-items: baseline; gap: var(--cds-gap-sm); }\n.al-service dl { margin: 0; display: grid; gap: var(--cds-gap-xs); }\n.al-service dt { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n.al-service dd { margin: 0 0 var(--cds-gap-xs); line-height: 1.45; }\n.al-service a { color: inherit; }\n/* Charts */\n.al-chart { position: relative; min-height: 120px; }\n.al-chart svg { display: block; overflow: visible; }\n.al-chart text { font-size: var(--cds-font-size-caption); fill: var(--cds-text-secondary); }\n.al-chart .value { fill: var(--color-fg); font-variant-numeric: tabular-nums; }\n.al-tip { position: absolute; pointer-events: none; background: var(--cds-surface-popover); border: 1px solid var(--cds-border); box-shadow: var(--cds-shadow-popover); border-radius: var(--cds-radius); padding: var(--cds-pad-xs) var(--cds-pad-sm); font-size: var(--cds-font-size-caption); white-space: nowrap; }\n.al-legend { display: flex; flex-wrap: wrap; gap: var(--cds-gap-md); font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n.al-swatch { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-right: 6px; vertical-align: -1px; }\n.al-split { display: flex; flex-wrap: wrap; gap: var(--cds-gap-lg); }\n.al-split > * { flex: 1 1 280px; min-width: 0; }\n[data-dash-source-state=refreshing] { opacity: .5; }\n@media (prefers-reduced-motion: no-preference) { .al-meter > span { transition: width var(--cds-dur-slow) var(--cds-ease-out); } }\n</style>\n\n<div class=\"al\">\n  <header class=\"al-head\" id=\"summary\">\n    <h1>Almanac Dashboard</h1>\n    <p class=\"al-lede\">\n      <b data-draw=\"snap\" data-source=\"snapshot\" data-field=\"goals_done\" data-row=\"0\">\u2014</b> of\n      <b data-draw=\"snap\" data-source=\"snapshot\" data-field=\"goals_total\" data-row=\"0\">\u2014</b> goals in your development log are done, and\n      <b data-draw=\"snap\" data-source=\"snapshot\" data-field=\"milestones_done\" data-row=\"0\">\u2014</b> of\n      <b data-draw=\"snap\" data-source=\"snapshot\" data-field=\"milestones_total\" data-row=\"0\">\u2014</b> milestones have shipped.\n      <span data-costline=\"under\">Running costs stay inside Fly's $<b data-draw=\"cost\" data-source=\"cost_summary\" data-field=\"fly_waiver_usd\" data-row=\"0\">\u2014</b> monthly waiver, so the expected bill is $0.</span>\n      <span data-costline=\"over\" hidden>Running costs could pass Fly's monthly waiver; check the Financials tab.</span>\n      <span data-draw=\"costpick\"></span>\n    </p>\n    <p class=\"al-fresh\">Data from <span data-draw=\"snapdate\" data-source=\"snapshot\" data-field=\"date\" data-row=\"0\">\u2014</span>, built from the project, the development log and published price lists.</p>\n  </header>\n\n  <div class=\"al-tiles\" id=\"tiles\">\n    <div class=\"al-card al-tile\" id=\"tile-goals\">\n      <span class=\"al-label\">Development log goals done</span>\n      <span class=\"al-big\"><span data-draw=\"snap\" data-source=\"snapshot\" data-field=\"goals_done\" data-row=\"0\">\u2014</span> <small>of <span data-draw=\"snap\" data-source=\"snapshot\" data-field=\"goals_total\" data-row=\"0\">\u2014</span></small></span>\n      <div class=\"al-meter\" aria-hidden=\"true\"><span data-draw=\"goalmeter\"></span></div>\n    </div>\n    <div class=\"al-card al-tile\" id=\"tile-milestones\">\n      <span class=\"al-label\">Milestones shipped</span>\n      <span class=\"al-big\"><span data-draw=\"snap\" data-source=\"snapshot\" data-field=\"milestones_done\" data-row=\"0\">\u2014</span> <small>of <span data-draw=\"snap\" data-source=\"snapshot\" data-field=\"milestones_total\" data-row=\"0\">\u2014</span></small></span>\n      <span class=\"al-sub\">M0 to M6, with M2.5 and M2.6</span>\n    </div>\n    <div class=\"al-card al-tile\" id=\"tile-questions\">\n      <span class=\"al-label\">Questions ready to play</span>\n      <span class=\"al-big\"><span data-draw=\"snap\" data-source=\"snapshot\" data-field=\"questions_servable\" data-row=\"0\">\u2014</span> <small>of <span data-draw=\"snap\" data-source=\"snapshot\" data-field=\"questions_total\" data-row=\"0\">\u2014</span></small></span>\n      <span class=\"al-sub\"><span data-draw=\"snap\" data-source=\"snapshot\" data-field=\"case_questions_servable\" data-row=\"0\">\u2014</span> of them case questions</span>\n    </div>\n    <div class=\"al-card al-tile\" id=\"tile-tests\">\n      <span class=\"al-label\">Automated tests</span>\n      <span class=\"al-big\" data-draw=\"snap\" data-source=\"snapshot\" data-field=\"tests\" data-row=\"0\">\u2014</span>\n      <span class=\"al-sub\"><span data-draw=\"snap\" data-source=\"snapshot\" data-field=\"code_lines\" data-row=\"0\">\u2014</span> lines of code in <span data-draw=\"snap\" data-source=\"snapshot\" data-field=\"code_files\" data-row=\"0\">\u2014</span> files</span>\n    </div>\n    <div class=\"al-card al-tile\" id=\"tile-cost\">\n      <span class=\"al-label\">Running cost, most per month</span>\n      <span class=\"al-big\">$<span data-draw=\"cost\" data-source=\"cost_summary\" data-field=\"monthly_max_usd\" data-row=\"0\">\u2014</span></span>\n      <span class=\"al-sub\">If the server never slept. Revenue: $<span data-draw=\"cost\" data-source=\"cost_summary\" data-field=\"revenue_usd\" data-row=\"0\">\u2014</span>, by design.</span>\n    </div>\n  </div>\n\n  <nav class=\"al-tabs\" role=\"tablist\" aria-label=\"Dashboard sections\" id=\"menu\">\n    <button class=\"al-tab\" role=\"tab\" type=\"button\" data-tab=\"progress\" aria-selected=\"true\">Progress</button>\n    <button class=\"al-tab\" role=\"tab\" type=\"button\" data-tab=\"financials\" aria-selected=\"false\">Financials</button>\n    <button class=\"al-tab\" role=\"tab\" type=\"button\" data-tab=\"services\" aria-selected=\"false\">Services</button>\n    <button class=\"al-tab\" role=\"tab\" type=\"button\" data-tab=\"tools\" aria-selected=\"false\">Tools</button>\n    <button class=\"al-tab\" role=\"tab\" type=\"button\" data-tab=\"questions\" aria-selected=\"false\">Questions</button>\n  </nav>\n\n  <section class=\"al-section\" id=\"progress\" role=\"tabpanel\">\n    <div class=\"al-block\" id=\"principles\">\n      <h2>Principles from the log</h2>\n      <div class=\"al-principles\" data-draw=\"principles\" data-source=\"principles\"></div>\n    </div>\n\n    <div class=\"al-block\" id=\"goals\">\n      <div class=\"al-blockhead\">\n        <h2>Development log</h2>\n        <span class=\"al-note\">Pick a heading to see its goals. A goal you add to the log appears here at the next refresh.</span>\n      </div>\n      <div class=\"al-goals\">\n        <div class=\"al-menu\" data-draw=\"goalmenu\" data-source=\"goal_sections\" role=\"group\" aria-label=\"Log headings\"></div>\n        <div class=\"al-list-wrap\">\n          <div class=\"al-filter\">\n            <label class=\"al-label\" for=\"status-filter\">Show</label>\n            <select class=\"dash-select\" id=\"status-filter\" aria-label=\"Filter goals by status\">\n              <option value=\"\">Every status</option>\n              <option value=\"done\">Done</option>\n              <option value=\"in_progress\">In progress</option>\n              <option value=\"ongoing\">Ongoing</option>\n              <option value=\"planned\">Planned</option>\n              <option value=\"not_started\">Not started</option>\n              <option value=\"untracked\">Not tracked yet</option>\n            </select>\n          </div>\n          <ul class=\"al-list\" data-draw=\"goallist\" data-source=\"goals\"></ul>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"al-block\" id=\"milestones\">\n      <h2>Milestones</h2>\n      <div class=\"al-steps\" data-draw=\"milestones\" data-source=\"milestones\"></div>\n    </div>\n\n    <div class=\"al-split\">\n      <div class=\"al-block\" id=\"timeline\">\n        <h2>What shipped when</h2>\n        <ul class=\"al-timeline\" data-draw=\"timeline\" data-source=\"timeline\"></ul>\n      </div>\n      <div class=\"al-block\" id=\"history\">\n        <h2>Snapshots</h2>\n        <p class=\"al-note\">One row per refresh, so you can see the project grow.</p>\n        <div class=\"al-scroll\">\n          <table class=\"al-table\" data-source=\"history\" data-row-key=\"date\">\n            <thead><tr><th data-field=\"date\">Date</th><th data-field=\"goals_done\" class=\"num\">Goals done</th><th data-field=\"tests\" class=\"num\">Tests</th><th data-field=\"questions_servable\" class=\"num\">Questions</th><th data-field=\"code_lines\" class=\"num\">Lines</th></tr></thead>\n            <tbody data-draw=\"history\"></tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"al-section\" id=\"financials\" role=\"tabpanel\" hidden>\n    <div class=\"al-block\" id=\"costs\">\n      <div class=\"al-blockhead\">\n        <h2>Monthly running costs</h2>\n        <span class=\"al-note\">Prices checked <span data-draw=\"cost\" data-source=\"cost_summary\" data-field=\"prices_checked\" data-row=\"0\">\u2014</span>. These are ceilings worked out from the price lists, not bills.</span>\n      </div>\n      <div class=\"al-scroll\">\n        <table class=\"al-table\" data-source=\"costs\" data-row-key=\"item\">\n          <thead><tr><th data-field=\"item\">Item</th><th data-field=\"service\">Service</th><th data-field=\"basis\">How it's charged</th><th data-field=\"monthly_max_usd\" class=\"num\">Most per month</th></tr></thead>\n          <tbody data-draw=\"costs\"></tbody>\n          <tfoot><tr><td colspan=\"3\">Total if the server never slept</td><td class=\"num\">$<span data-draw=\"cost\" data-source=\"cost_summary\" data-field=\"monthly_max_usd\" data-row=\"0\">\u2014</span></td></tr></tfoot>\n        </table>\n      </div>\n      <p class=\"al-note\">Fly waives a personal organization's bill when it comes to less than $5 in a month, and the server stops whenever no game is open, so the bill should be $0. No real money moves through the game: coins are earned only by playing.</p>\n    </div>\n\n    <div class=\"al-block\" id=\"anthropic\">\n      <h2>Question research on the Claude API</h2>\n      <p class=\"al-note\">The verifier is the only paid service used outside hosting. It runs from your terminal and is charged per token and per web search at these rates.</p>\n      <div class=\"al-scroll\">\n        <table class=\"al-table\" data-source=\"model_rates\" data-row-key=\"model\">\n          <thead><tr><th data-field=\"model\">Model</th><th data-field=\"use\">Used for</th><th data-field=\"input_per_million_usd\" class=\"num\">Input, per million tokens</th><th data-field=\"output_per_million_usd\" class=\"num\">Output, per million tokens</th><th data-field=\"web_search_per_thousand_usd\" class=\"num\">Per 1,000 searches</th></tr></thead>\n          <tbody data-draw=\"rates\"></tbody>\n        </table>\n      </div>\n      <h3>Verifier spend, by run</h3>\n      <p class=\"al-note\">Logged from November 10, 2026 on. Earlier runs printed their cost in the terminal but weren't saved; your Anthropic console has those.</p>\n      <div class=\"al-scroll\">\n        <table class=\"al-table\" data-source=\"verifier_spend\" data-row-key=\"date,model,questions\">\n          <thead><tr><th data-field=\"date\">Date</th><th data-field=\"model\">Model</th><th data-field=\"questions\" class=\"num\">Questions</th><th data-field=\"searches\" class=\"num\">Searches</th><th data-field=\"usd\" class=\"num\">Cost</th></tr></thead>\n          <tbody data-draw=\"spend\"></tbody>\n        </table>\n      </div>\n      <p class=\"al-empty\" data-draw=\"spendempty\"></p>\n    </div>\n  </section>\n\n  <section class=\"al-section\" id=\"services\" role=\"tabpanel\" hidden>\n    <div class=\"al-block\">\n      <h2>Outside services</h2>\n      <p class=\"al-note\">Everything Almanac relies on that someone else runs, what it does for the game, and what it costs.</p>\n      <div class=\"al-services\" data-draw=\"services\" data-source=\"services\"></div>\n    </div>\n  </section>\n\n  <section class=\"al-section\" id=\"tools\" role=\"tabpanel\" hidden>\n    <div class=\"al-block\">\n      <h2>What the program runs on</h2>\n      <p class=\"al-note\">Versions as installed now: the server's packages, the client's packages and the images Fly builds from.</p>\n      <div class=\"al-scroll\">\n        <table class=\"al-table\" data-source=\"stack\" data-row-key=\"tool\">\n          <thead><tr><th data-field=\"layer\">Layer</th><th data-field=\"tool\">Tool</th><th data-field=\"version\">Version</th><th data-field=\"role\">What it does</th></tr></thead>\n          <tbody data-draw=\"stack\"></tbody>\n        </table>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"al-section\" id=\"questions\" role=\"tabpanel\" hidden>\n    <div class=\"al-block\" id=\"question-categories\">\n      <h2>Questions ready to play, by category</h2>\n      <div class=\"al-legend\">\n        <span><span class=\"al-swatch\" data-draw=\"swatch\" data-kind=\"standard\"></span>Standard</span>\n        <span><span class=\"al-swatch\" data-draw=\"swatch\" data-kind=\"case\"></span>Case question</span>\n      </div>\n      <div class=\"al-chart\" data-draw=\"qchart\" data-source=\"questions_by_category\"></div>\n    </div>\n    <div class=\"al-split\">\n      <div class=\"al-block\" id=\"question-status\">\n        <h2>Where every question stands</h2>\n        <div class=\"al-scroll\">\n          <table class=\"al-table\" data-source=\"questions_by_status\" data-row-key=\"status\">\n            <thead><tr><th data-field=\"status\">Status</th><th data-field=\"questions\" class=\"num\">Questions</th></tr></thead>\n            <tbody data-draw=\"qstatus\"></tbody>\n          </table>\n        </div>\n        <p class=\"al-note\">Games serve verified and agent-verified questions. Disputed ones wait for you to settle them.</p>\n      </div>\n      <div class=\"al-block\" id=\"verifier-runs\">\n        <h2>Verifier runs</h2>\n        <div class=\"al-chart\" data-draw=\"runchart\" data-source=\"verifier_checks\"></div>\n      </div>\n    </div>\n  </section>\n</div>\n\n<script>\n// Every source is one key of the dashboard file that tools/dashboard/refresh.py writes.\ndash.loader('goals', { description: 'Takes the goals list out of the dashboard file.', fn: ({ answer }) => answer.goals });\ndash.loader('milestones', { description: 'Takes the milestones out of the dashboard file.', fn: ({ answer }) => answer.milestones });\ndash.loader('timeline', { description: 'Takes the timeline out of the dashboard file.', fn: ({ answer }) => answer.timeline });\ndash.loader('principles', { description: 'Takes the principles out of the dashboard file.', fn: ({ answer }) => answer.principles });\ndash.loader('snapshot', { description: 'Takes the latest snapshot out of the dashboard file.', fn: ({ answer }) => answer.snapshot });\ndash.loader('history', { description: 'Takes the snapshot history out of the dashboard file.', fn: ({ answer }) => answer.history });\ndash.loader('questions_by_category', { description: 'Takes question counts by category out of the dashboard file.', fn: ({ answer }) => answer.questions_by_category });\ndash.loader('questions_by_status', { description: 'Takes question counts by status out of the dashboard file.', fn: ({ answer }) => answer.questions_by_status });\ndash.loader('verifier_checks', { description: 'Takes the verifier runs out of the dashboard file.', fn: ({ answer }) => answer.verifier_checks });\ndash.loader('verifier_spend', { description: 'Takes the logged verifier costs out of the dashboard file.', fn: ({ answer }) => answer.verifier_spend });\ndash.loader('model_rates', { description: 'Takes the Claude model rates out of the dashboard file.', fn: ({ answer }) => answer.model_rates });\ndash.loader('costs', { description: 'Takes the cost lines out of the dashboard file.', fn: ({ answer }) => answer.costs });\ndash.loader('cost_summary', { description: 'Takes the cost summary out of the dashboard file.', fn: ({ answer }) => answer.cost_summary });\ndash.loader('services', { description: 'Takes the services out of the dashboard file.', fn: ({ answer }) => answer.services });\ndash.loader('stack', { description: 'Takes the tools and versions out of the dashboard file.', fn: ({ answer }) => answer.stack });\n\ndash.calc('goal_sections', {\n  inputs: ['goals'],\n  title: 'Goals by log heading',\n  description: 'How many goals sit under each heading of the development log, and how many of them are done.',\n  fn: (goals) => {\n    const order = [];\n    const bySection = {};\n    for (const goal of goals) {\n      if (!bySection[goal.section]) {\n        bySection[goal.section] = { section: goal.section, done: 0, total: 0 };\n        order.push(goal.section);\n      }\n      bySection[goal.section].total += 1;\n      if (goal.status === 'done') bySection[goal.section].done += 1;\n    }\n    return order.map((section) => bySection[section]);\n  },\n});\n</script>\n\n<script>\n// Shared helpers and the page's own state (which heading and status are picked).\nwindow.almanac = window.almanac || { section: '', status: '' };\nwindow.almanac.STATUS = {\n  done: 'Done', in_progress: 'In progress', ongoing: 'Ongoing', planned: 'Planned', not_started: 'Not started', untracked: 'Not tracked yet',\n};\nwindow.almanac.QSTATUS = {\n  verified: 'Verified by you', agent_verified: 'Agent-verified', needs_review: 'Needs review', disputed: 'Disputed', unverified: 'Not checked yet',\n};\nwindow.almanac.day = (iso) => {\n  const parsed = d3.utcParse('%Y-%m-%d')(String(iso || '').slice(0, 10));\n  return parsed ? d3.utcFormat('%b %-d, %Y')(parsed) : '\u2014';\n};\nwindow.almanac.money = (value) => (value === null || value === undefined || value === '' ? '\u2014' : d3.format(',.2f')(+value));\nwindow.almanac.enc = (value) => String(value).replace(/%/g, '%25').replace(/&/g, '%26').replace(/=/g, '%3D');\nwindow.almanac.whereOf = (column, value) => `${window.almanac.enc(column)}=${window.almanac.enc(value)}`;\nwindow.almanac.ready = (id) => dash.data(id).status === 'ok';\n</script>\n\n<script>\n// Tabs: one section shows at a time; the open one goes in the link.\n(function () {\n  const tabs = Array.from(document.querySelectorAll('.al-tab'));\n  function open(name) {\n    const known = tabs.some((tab) => tab.dataset.tab === name);\n    const target = known ? name : 'progress';\n    for (const tab of tabs) tab.setAttribute('aria-selected', String(tab.dataset.tab === target));\n    for (const section of document.querySelectorAll('.al-section')) section.hidden = section.id !== target;\n    dash.setLink(target);\n  }\n  for (const tab of tabs) tab.addEventListener('click', () => open(tab.dataset.tab));\n  const start = (location.hash || '').replace('#', '');\n  if (start) open(start);\n  const filter = document.getElementById('status-filter');\n  if (filter) filter.addEventListener('change', () => { window.almanac.status = filter.value; dash.draw('goallist'); });\n})();\n</script>\n\n<script>\n// Summary band.\ndash.draw('snap', (el) => {\n  const source = dash.data('snapshot');\n  const row = source.status === 'ok' ? source.data[0] : null;\n  const value = row ? row[el.dataset.field] : null;\n  el.textContent = value === null || value === undefined ? '\u2014' : d3.format(',')(+value);\n});\ndash.draw('snapdate', (el) => {\n  const source = dash.data('snapshot');\n  el.textContent = source.status === 'ok' && source.data[0] ? window.almanac.day(source.data[0].date) : '\u2014';\n});\ndash.draw('cost', (el) => {\n  const source = dash.data('cost_summary');\n  const row = source.status === 'ok' ? source.data[0] : null;\n  if (!row) { el.textContent = '\u2014'; return; }\n  const field = el.dataset.field;\n  if (field === 'prices_checked') el.textContent = window.almanac.day(row[field]);\n  else if (field === 'fly_waiver_usd' || field === 'revenue_usd') el.textContent = d3.format(',')(+row[field]);\n  else el.textContent = window.almanac.money(row[field]);\n});\ndash.draw('costpick', () => {\n  const source = dash.data('cost_summary');\n  const row = source.status === 'ok' ? source.data[0] : null;\n  const over = row ? +row.monthly_max_usd >= +row.fly_waiver_usd : false;\n  for (const span of document.querySelectorAll('[data-costline]')) span.hidden = (span.dataset.costline === 'over') !== over;\n});\ndash.draw('goalmeter', (el) => {\n  const source = dash.data('snapshot');\n  const row = source.status === 'ok' ? source.data[0] : null;\n  el.style.width = row && +row.goals_total ? `${(100 * row.goals_done) / row.goals_total}%` : '0';\n});\n</script>\n\n<script>\n// The progress menu and the goal list.\ndash.draw('principles', (el) => {\n  const source = dash.data('principles');\n  el.replaceChildren();\n  if (source.status !== 'ok') { el.textContent = '\u2014'; return; }\n  source.data.forEach((row, index) => {\n    const quote = document.createElement('p');\n    quote.className = 'al-principle';\n    quote.dataset.source = 'principles';\n    quote.dataset.field = 'principle';\n    quote.dataset.row = String(index);\n    quote.textContent = row.principle;\n    el.append(quote);\n  });\n});\n\ndash.draw('goalmenu', (el) => {\n  const sections = dash.data('goal_sections');\n  const goals = dash.data('goals');\n  el.replaceChildren();\n  if (sections.status !== 'ok' || !Array.isArray(sections.data)) { el.textContent = '\u2014'; return; }\n  const doneAll = goals.status === 'ok' ? goals.data.filter((g) => g.status === 'done').length : 0;\n  const totalAll = goals.status === 'ok' ? goals.data.length : 0;\n  const entries = [{ section: '', label: 'All headings', done: doneAll, total: totalAll, marked: false }]\n    .concat(sections.data.map((row) => ({ section: row.section, label: row.section, done: row.done, total: row.total, marked: true })));\n  for (const entry of entries) {\n    const button = document.createElement('button');\n    button.type = 'button';\n    button.setAttribute('aria-pressed', String(window.almanac.section === entry.section));\n    const top = document.createElement('span');\n    top.className = 'al-menu-row';\n    const name = document.createElement('span');\n    name.textContent = entry.label;\n    const count = document.createElement('span');\n    count.className = 'al-menu-count';\n    const done = document.createElement('span');\n    done.textContent = String(entry.done);\n    const total = document.createElement('span');\n    total.textContent = String(entry.total);\n    if (entry.marked) {\n      const where = window.almanac.whereOf('section', entry.section);\n      Object.assign(done.dataset, { source: 'goal_sections', field: 'done', where });\n      Object.assign(total.dataset, { source: 'goal_sections', field: 'total', where });\n    }\n    count.append(done, ' of ', total);\n    top.append(name, count);\n    const meter = document.createElement('span');\n    meter.className = 'al-meter';\n    const fill = document.createElement('span');\n    fill.style.width = entry.total ? `${(100 * entry.done) / entry.total}%` : '0';\n    meter.append(fill);\n    button.append(top, meter);\n    button.addEventListener('click', () => {\n      window.almanac.section = entry.section;\n      dash.draw('goalmenu');\n      dash.draw('goallist');\n    });\n    el.append(button);\n  }\n});\n\ndash.draw('goallist', (el) => {\n  const source = dash.data('goals');\n  el.replaceChildren();\n  if (source.status !== 'ok') {\n    const item = document.createElement('li');\n    item.className = 'al-empty';\n    item.textContent = source.status === 'error' ? 'Failed to load' : '\u2014';\n    el.append(item);\n    return;\n  }\n  const { section, status } = window.almanac;\n  const shown = source.data.filter((g) => (!section || g.section === section) && (!status || g.status === status));\n  if (!shown.length) {\n    const item = document.createElement('li');\n    item.className = 'al-empty';\n    item.textContent = 'No goals here with that status.';\n    el.append(item);\n    return;\n  }\n  for (const goal of shown) {\n    const where = window.almanac.whereOf('order', goal.order);\n    const item = document.createElement('li');\n    item.className = `al-goal depth-${goal.depth > 1 ? 2 : 1}`;\n    const text = document.createElement('span');\n    text.className = 'al-goal-text';\n    Object.assign(text.dataset, { source: 'goals', field: 'goal', where });\n    text.textContent = goal.goal;\n    const pill = document.createElement('span');\n    pill.className = `al-pill st-${goal.status}`;\n    Object.assign(pill.dataset, { source: 'goals', field: 'status', where });\n    pill.textContent = window.almanac.STATUS[goal.status] || goal.status;\n    item.append(text, pill);\n    if (goal.note) {\n      const note = document.createElement('span');\n      note.className = 'al-goal-note';\n      Object.assign(note.dataset, { source: 'goals', field: 'note', where });\n      note.textContent = goal.note;\n      item.append(note);\n    }\n    const meta = [];\n    if (!section) meta.push(goal.section);\n    if (goal.milestone) meta.push(goal.milestone);\n    if (goal.since) meta.push(`since ${window.almanac.day(goal.since)}`);\n    if (meta.length) {\n      const line = document.createElement('span');\n      line.className = 'al-goal-meta';\n      line.textContent = meta.join(' \u00b7 ');\n      item.append(line);\n    }\n    el.append(item);\n  }\n});\n\ndash.draw('milestones', (el) => {\n  const source = dash.data('milestones');\n  el.replaceChildren();\n  if (source.status !== 'ok') { el.textContent = '\u2014'; return; }\n  for (const m of source.data) {\n    const where = window.almanac.whereOf('id', m.id);\n    const card = document.createElement('div');\n    card.className = 'al-step';\n    const top = document.createElement('div');\n    top.className = 'al-step-top';\n    const id = document.createElement('span');\n    id.className = 'al-step-id';\n    id.textContent = m.id;\n    const pill = document.createElement('span');\n    pill.className = `al-pill st-${m.status}`;\n    Object.assign(pill.dataset, { source: 'milestones', field: 'status', where });\n    pill.textContent = window.almanac.STATUS[m.status] || m.status;\n    top.append(id, pill);\n    const name = document.createElement('span');\n    name.className = 'al-step-name';\n    Object.assign(name.dataset, { source: 'milestones', field: 'name', where });\n    name.textContent = m.name;\n    const summary = document.createElement('span');\n    summary.className = 'al-sub';\n    Object.assign(summary.dataset, { source: 'milestones', field: 'summary', where });\n    summary.textContent = m.summary;\n    card.append(top, name, summary);\n    if (m.shipped) {\n      const shipped = document.createElement('span');\n      shipped.className = 'al-sub';\n      Object.assign(shipped.dataset, { source: 'milestones', field: 'shipped', where });\n      shipped.textContent = `Shipped ${window.almanac.day(m.shipped)}`;\n      card.append(shipped);\n    }\n    if (m.open) {\n      const open = document.createElement('span');\n      open.className = 'al-sub';\n      Object.assign(open.dataset, { source: 'milestones', field: 'open', where });\n      open.textContent = `Open: ${m.open}`;\n      card.append(open);\n    }\n    el.append(card);\n  }\n});\n\ndash.draw('timeline', (el) => {\n  const source = dash.data('timeline');\n  el.replaceChildren();\n  if (source.status !== 'ok') return;\n  for (const row of [...source.data].reverse()) {\n    const where = window.almanac.whereOf('date', row.date);\n    const item = document.createElement('li');\n    const when = document.createElement('span');\n    when.className = 'al-date';\n    Object.assign(when.dataset, { source: 'timeline', field: 'date', where });\n    when.textContent = window.almanac.day(row.date);\n    const body = document.createElement('div');\n    const title = document.createElement('h3');\n    Object.assign(title.dataset, { source: 'timeline', field: 'title', where });\n    title.textContent = row.title;\n    const detail = document.createElement('p');\n    detail.className = 'al-sub';\n    Object.assign(detail.dataset, { source: 'timeline', field: 'detail', where });\n    detail.textContent = row.detail;\n    body.append(title, detail);\n    item.append(when, body);\n    el.append(item);\n  }\n});\n\ndash.draw('history', (el) => {\n  const source = dash.data('history');\n  el.replaceChildren();\n  if (source.status !== 'ok') return;\n  for (const row of [...source.data].reverse()) {\n    const tr = document.createElement('tr');\n    const cells = [\n      [window.almanac.day(row.date), ''],\n      [`${row.goals_done} of ${row.goals_total}`, 'num'],\n      [d3.format(',')(row.tests), 'num'],\n      [d3.format(',')(row.questions_servable), 'num'],\n      [d3.format(',')(row.code_lines), 'num'],\n    ];\n    for (const [text, cls] of cells) {\n      const td = document.createElement('td');\n      if (cls) td.className = cls;\n      td.textContent = text;\n      tr.append(td);\n    }\n    tr.dataset.key = window.almanac.enc(row.date);\n    el.append(tr);\n  }\n});\n</script>\n\n<script>\n// Financials, services and tools.\nfunction almanacRows(el, id) {\n  const source = dash.data(id);\n  el.replaceChildren();\n  if (source.status !== 'ok') return [];\n  return source.data;\n}\n\ndash.draw('costs', (el) => {\n  for (const row of almanacRows(el, 'costs')) {\n    const tr = document.createElement('tr');\n    const cells = [[row.item, ''], [row.service, ''], [row.basis, 'wrap'], [`$${window.almanac.money(row.monthly_max_usd)}`, 'num']];\n    for (const [text, cls] of cells) {\n      const td = document.createElement('td');\n      if (cls) td.className = cls;\n      td.textContent = text;\n      tr.append(td);\n    }\n    el.append(tr);\n  }\n});\n\ndash.draw('rates', (el) => {\n  for (const row of almanacRows(el, 'model_rates')) {\n    const tr = document.createElement('tr');\n    const cells = [\n      [row.model, ''], [row.use, ''],\n      [`$${window.almanac.money(row.input_per_million_usd)}`, 'num'],\n      [`$${window.almanac.money(row.output_per_million_usd)}`, 'num'],\n      [`$${window.almanac.money(row.web_search_per_thousand_usd)}`, 'num'],\n    ];\n    for (const [text, cls] of cells) {\n      const td = document.createElement('td');\n      if (cls) td.className = cls;\n      td.textContent = text;\n      tr.append(td);\n    }\n    el.append(tr);\n  }\n});\n\ndash.draw('spend', (el) => {\n  for (const row of almanacRows(el, 'verifier_spend')) {\n    const tr = document.createElement('tr');\n    tr.dataset.key = [row.date, row.model, row.questions].map((v) => window.almanac.enc(v)).join(',');\n    const cells = [\n      [window.almanac.day(row.date), ''], [row.model, ''],\n      [d3.format(',')(row.questions), 'num'], [d3.format(',')(row.searches), 'num'],\n      [`$${window.almanac.money(row.usd)}`, 'num'],\n    ];\n    for (const [text, cls] of cells) {\n      const td = document.createElement('td');\n      if (cls) td.className = cls;\n      td.textContent = text;\n      tr.append(td);\n    }\n    el.append(tr);\n  }\n});\n\ndash.draw('spendempty', (el) => {\n  const source = dash.data('verifier_spend');\n  el.textContent = source.status === 'ok' && source.data.length === 0\n    ? 'No runs logged yet. The next time you run the verifier, its tokens, searches and cost appear here.'\n    : '';\n});\n\ndash.draw('services', (el) => {\n  const source = dash.data('services');\n  el.replaceChildren();\n  if (source.status !== 'ok') { el.textContent = '\u2014'; return; }\n  for (const row of source.data) {\n    const where = window.almanac.whereOf('service', row.service);\n    const card = document.createElement('article');\n    card.className = 'al-card al-service';\n    const top = document.createElement('div');\n    top.className = 'al-service-top';\n    const name = document.createElement('h3');\n    Object.assign(name.dataset, { source: 'services', field: 'service', where });\n    if (row.link) {\n      const link = document.createElement('a');\n      link.href = row.link;\n      link.target = '_blank';\n      link.rel = 'noreferrer';\n      link.textContent = row.service;\n      name.append(link);\n    } else {\n      name.textContent = row.service;\n    }\n    const tag = document.createElement('span');\n    tag.className = 'al-pill';\n    Object.assign(tag.dataset, { source: 'services', field: 'category', where });\n    tag.textContent = row.category;\n    top.append(name, tag);\n    const list = document.createElement('dl');\n    for (const [label, field] of [['What it does for Almanac', 'role'], ['How it is set up', 'setup'], ['Cost', 'pricing'], ['In use since', 'since']]) {\n      const dt = document.createElement('dt');\n      dt.textContent = label;\n      const dd = document.createElement('dd');\n      Object.assign(dd.dataset, { source: 'services', field, where });\n      dd.textContent = field === 'since' ? window.almanac.day(row[field]) : row[field];\n      list.append(dt, dd);\n    }\n    card.append(top, list);\n    el.append(card);\n  }\n});\n\ndash.draw('stack', (el) => {\n  const rows = almanacRows(el, 'stack');\n  for (const row of rows) {\n    const tr = document.createElement('tr');\n    for (const [text, cls] of [[row.layer, ''], [row.tool, ''], [row.version || '\u2014', 'num'], [row.role, 'wrap']]) {\n      const td = document.createElement('td');\n      if (cls) td.className = cls;\n      td.textContent = text;\n      tr.append(td);\n    }\n    el.append(tr);\n  }\n});\n\ndash.draw('qstatus', (el) => {\n  for (const row of almanacRows(el, 'questions_by_status')) {\n    const tr = document.createElement('tr');\n    tr.dataset.key = window.almanac.enc(row.status);\n    const name = document.createElement('td');\n    name.textContent = window.almanac.QSTATUS[row.status] || row.status;\n    const count = document.createElement('td');\n    count.className = 'num';\n    count.textContent = d3.format(',')(row.questions);\n    tr.append(name, count);\n    el.append(tr);\n  }\n});\n</script>\n\n<script>\n// Charts: horizontal bars sized from the box's width, values printed at the bar ends, a tooltip on point.\nfunction almanacBars(el, { rows, label, value, color, tip, source, aria }) {\n  el.replaceChildren();\n  const width = Math.max(260, el.clientWidth || 600);\n  const rowHeight = 26;\n  const height = rows.length * rowHeight + 8;\n  const svg = d3.select(el).append('svg')\n    .attr('width', '100%').attr('viewBox', `0 0 ${width} ${height}`)\n    .attr('role', 'img').attr('aria-label', aria);\n  const labels = svg.append('g');\n  labels.selectAll('text').data(rows).join('text')\n    .attr('x', 0).attr('y', (d, i) => i * rowHeight + rowHeight / 2 + 4)\n    .text((d) => label(d));\n  let labelWidth = 0;\n  labels.selectAll('text').each(function () { labelWidth = Math.max(labelWidth, this.getComputedTextLength()); });\n  const left = Math.ceil(labelWidth) + 12;\n  const right = 44;\n  const max = d3.max(rows, value) || 1;\n  const x = d3.scaleLinear().domain([0, max]).range([0, Math.max(40, width - left - right)]);\n  svg.append('g').selectAll('line').data(x.ticks(4)).join('line')\n    .attr('x1', (d) => left + x(d)).attr('x2', (d) => left + x(d)).attr('y1', 0).attr('y2', height - 4)\n    .style('stroke', 'var(--cds-chart-grid)');\n  const tipBox = document.createElement('div');\n  tipBox.className = 'al-tip';\n  tipBox.hidden = true;\n  el.append(tipBox);\n  const bars = svg.append('g').selectAll('rect').data(rows).join('rect')\n    .attr('x', left).attr('y', (d, i) => i * rowHeight + 5)\n    .attr('width', (d) => Math.max(1, x(value(d)))).attr('height', rowHeight - 10).attr('rx', 3)\n    .style('fill', (d) => color(d));\n  if (source) bars.each(function (d) { this.dataset.source = source.id; this.dataset.field = source.field; this.dataset.where = source.where(d); });\n  svg.append('g').selectAll('text').data(rows).join('text')\n    .attr('class', 'value').attr('x', (d) => left + x(value(d)) + 6).attr('y', (d, i) => i * rowHeight + rowHeight / 2 + 4)\n    .text((d) => d3.format(',')(value(d)));\n  bars.on('pointerenter pointermove', (event, d) => {\n    tipBox.textContent = tip(d);\n    tipBox.hidden = false;\n    const [px, py] = d3.pointer(event, el);\n    const boxWidth = tipBox.offsetWidth;\n    tipBox.style.left = `${Math.min(Math.max(0, px + 12), el.clientWidth - boxWidth)}px`;\n    tipBox.style.top = `${py + 12}px`;\n  }).on('pointerleave', () => { tipBox.hidden = true; });\n}\n\ndash.draw('swatch', (el) => {\n  el.style.background = el.dataset.kind === 'case' ? dash.colors[1] : dash.colors[0];\n});\n\ndash.draw('qchart', (el) => {\n  const source = dash.data('questions_by_category');\n  if (source.status !== 'ok') { el.replaceChildren(); el.textContent = source.status === 'error' ? 'Failed to load' : '\u2014'; return; }\n  const rows = source.data.slice().sort((a, b) => b.servable - a.servable);\n  almanacBars(el, {\n    rows,\n    label: (d) => d.category,\n    value: (d) => +d.servable,\n    color: (d) => (d.kind === 'case' ? dash.colors[1] : dash.colors[0]),\n    tip: (d) => `${d.category}: ${d.servable} ready of ${d.total}${d.kind === 'case' ? ' (case questions)' : ''}`,\n    source: { id: 'questions_by_category', field: 'servable', where: (d) => `${window.almanac.whereOf('category', d.category)}&${window.almanac.whereOf('kind', d.kind)}` },\n    aria: 'Bar chart of questions ready to play in each category, standard and case questions in different colors.',\n  });\n});\n\ndash.draw('runchart', (el) => {\n  const source = dash.data('verifier_checks');\n  if (source.status !== 'ok') { el.replaceChildren(); el.textContent = source.status === 'error' ? 'Failed to load' : '\u2014'; return; }\n  const short = (model) => String(model).replace('claude-', '').replace(/-\\d.*$/, '');\n  almanacBars(el, {\n    rows: source.data,\n    label: (d) => `${d3.utcFormat('%b %-d')(d3.utcParse('%Y-%m-%d')(d.date))} \u00b7 ${short(d.model)}`,\n    value: (d) => +d.questions_checked,\n    color: () => dash.colors[0],\n    tip: (d) => `${window.almanac.day(d.date)}, ${d.model}: ${d.questions_checked} questions checked`,\n    source: { id: 'verifier_checks', field: 'questions_checked', where: (d) => `${window.almanac.whereOf('date', d.date)}&${window.almanac.whereOf('model', d.model)}` },\n    aria: 'Bar chart of how many questions each verifier run checked, by date and model.',\n  });\n});\n</script>\n", "edit": {"via": "claude", "at": "2026-11-11T02:42:44Z"}}